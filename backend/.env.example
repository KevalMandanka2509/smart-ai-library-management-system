# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=library_db

# JWT Security (REQUIRED - generate a random 32+ character string)
SECRET_KEY=your-super-secret-key-change-this-to-random-32-characters

# App Configuration
DEBUG=True
APP_NAME=Smart AI Library Management System
APP_VERSION=1.0.0

# Default Admin Account
DEFAULT_ADMIN_EMAIL=admin@yourlibrary.com
DEFAULT_ADMIN_PASSWORD=YourSecurePassword123!

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini AI (optional - AI chatbot features)
GEMINI_API_KEY=

# SMTP Email (optional - email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartlibrary.com
SMTP_FROM_NAME=Smart AI Library
SMTP_TLS=True

# SMS Provider (optional - SMS notifications)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=SMARTLIB
